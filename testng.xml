<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  The suite file Maven runs (see maven-surefire-plugin in pom.xml). To run it from the IDE, right-click it
  and choose Run. Run a group subset from the command line with -Dgroups=smoke or -DexcludedGroups=known-defect.
-->
<suite name="Bookings API regression suite" verbose="1">

    <listeners>
        <!-- Shuffles test order on every run so hidden dependencies between tests show up early. -->
        <listener class-name="com.reservationhub.support.RandomOrderInterceptor"/>
    </listeners>

    <test name="Bookings API">
        <classes>
            <!-- Smoke-level checks -->
            <class name="com.reservationhub.tests.HealthCheckTest"/>
            <class name="com.reservationhub.tests.BookingLifecycleTest"/>

            <!-- CRUD -->
            <class name="com.reservationhub.tests.CreateBookingTest"/>
            <class name="com.reservationhub.tests.GetBookingTest"/>
            <class name="com.reservationhub.tests.UpdateBookingTest"/>
            <class name="com.reservationhub.tests.PatchBookingTest"/>
            <class name="com.reservationhub.tests.DeleteBookingTest"/>

            <!-- Auth, validation and error handling -->
            <class name="com.reservationhub.tests.AuthTest"/>
            <class name="com.reservationhub.tests.BookingValidationTest"/>
            <class name="com.reservationhub.tests.NonExistentBookingTest"/>

            <!-- Performance smoke -->
            <class name="com.reservationhub.tests.PerformanceSmokeTest"/>
        </classes>
    </test>
</suite>
