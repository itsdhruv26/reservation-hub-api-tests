<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Smoke gate: is the core journey alive? -->
<suite name="Reservation Hub Bookings API Smoke" verbose="1">
    <listeners>
        <listener class-name="common.listeners.RetryBrokenTests"/>
    </listeners>
    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.reservationhub.testmodules.health.HealthCheckTest"/>
            <class name="com.reservationhub.testmodules.auth.AuthTest"/>
            <class name="com.reservationhub.testmodules.booking.BookingLifecycleTest"/>
            <class name="com.reservationhub.testmodules.booking.CreateBookingTest"/>
        </classes>
    </test>
</suite>
